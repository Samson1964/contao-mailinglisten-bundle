{
    "name": "schachbulle/contao-mailinglisten-bundle",
    "type": "contao-bundle",
    "description": "Betreibt beliebig viele Mailinglisten in Contao. Jede Liste hat ein eigenes Postfach; ein Cronjob holt neue E-Mails per IMAP ab und verteilt sie an die Teilnehmer. Nachrichten fremder Absender werden abgewiesen, die Aufnahme in die Liste lässt sich per Betreffkennung beantragen.",
    "keywords": [
        "contao",
        "mailingliste",
        "mailinglist",
        "imap",
        "verteiler",
        "cronjob"
    ],
    "homepage": "https://github.com/Samson1964/contao-mailinglisten-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-sodium": "*",
        "contao/core-bundle": "^4.13 || ^5.0",
        "webklex/php-imap": "^6.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/mailer": "^5.4 || ^6.4 || ^7.0",
        "symfony/mime": "^5.4 || ^6.4 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoMailinglistenBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoMailinglistenBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoMailinglistenBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-mailinglisten-bundle/issues",
        "source": "https://github.com/Samson1964/contao-mailinglisten-bundle"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true
        }
    }
}
